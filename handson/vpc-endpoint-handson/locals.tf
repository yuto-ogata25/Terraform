# ==============================================================================
# ローカル変数
# ==============================================================================
# 共通で使う値をまとめる。DRY原則（Don't Repeat Yourself）に従い、
# 同じ値を複数箇所に書かないようにする。

locals {
  # プロジェクト名（リソース名のプレフィックスに使用）
  project = "vpc-endpoint-handson"

  # AZ（東京リージョンの場合 ap-northeast-1a）
  az = "${var.region}a"
}
